REGRAG_LLM_BASE_URL=http://host.docker.internal:1234/v1
REGRAG_CHAT_MODELL=google/gemma-4-12b
REGRAG_API_KEY=lm-studio
REGRAG_JUDGE_MODELL=qwen/qwen3.5-9b

# Cloud / Linux (gehosteter Worker, Issue #4-Story):
# REGRAG_LLM_BASE_URL=https://openrouter.ai/api/v1
# REGRAG_CHAT_MODELL=qwen/qwen-2.5-72b-instruct
# REGRAG_API_KEY=sk-or-...

# Nur den DeepEval-Faithfulness-Judge hosted laufen lassen (App bleibt lokal).
# Ohne diese Werte nutzt der Judge denselben Endpunkt wie REGRAG_LLM_BASE_URL —
# lokal ist er laut ADR 0005 aber zu langsam. Gemessen wurde mit gpt-5.4-mini.
# REGRAG_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# REGRAG_JUDGE_MODELL=openai/gpt-5.4-mini
# REGRAG_JUDGE_API_KEY=sk-or-...
# REGRAG_JUDGE_TIMEOUT=120

# Eskalationsdatensatz bei ABSTAIN (JSONL). Default: chroma/eskalationen.jsonl
# REGRAG_ESKALATION_DATEI=chroma/eskalationen.jsonl

# Optionaler Answerability-Judge (ADR 0011). Leer = aus. Zero-shot ungemessen, Schwelle nicht kalibriert.
# Lokalen Server starten: pip install "laya[serve]" && laya-serve
# REGRAG_LAYA_URL=http://localhost:8000
# REGRAG_LAYA_API_KEY=
# REGRAG_LAYA_TIMEOUT=30
# REGRAG_LAYA_MAX_LEN=4096
# REGRAG_LAYA_LANG=de
# REGRAG_LAYA_MIN_ANSWERABLE=0.5
# Laya-Modell (Name am Server, nicht leer)
# REGRAG_LAYA_MODELL=multilingual
# Pfad zum Gate-Manifest mit kalibrierten Segmentschwellen (leer = aus)
# REGRAG_GATE_MANIFEST=

# Kostenfunktion für die Schwellenwahl (python -m evaluation.eval_report)
# REGRAG_KOSTEN_FALSCHANTWORT=10
# REGRAG_KOSTEN_ESKALATION=1
# REGRAG_EVAL_BERICHT_DIR=evaluation/reports
